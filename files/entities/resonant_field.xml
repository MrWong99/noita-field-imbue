<!-- Resonant field (files/actions.lua): a circle with no effect of its own, cast with Field resonance built in.
     Same shape as the vanilla fields (base_field.xml, radius 28); only the charm effect and look are replaced. -->
<Entity name="$projectile_default">
  <GameAreaEffectComponent
      radius="28"
    />

	<ParticleEmitterComponent
		emitted_material_name="spark_purple"
		gravity.y="0.0"
		lifetime_min="0.5"
		lifetime_max="1.5"
		count_min="1"
		count_max="2"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		area_circle_radius.max="28"
		cosmetic_force_create="0"
		airflow_force="0.5"
		airflow_time="0.01"
		airflow_scale="0.05"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		emit_cosmetic_particles="1"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<ParticleEmitterComponent
		emitted_material_name="spark_white"
		gravity.y="0.0"
		lifetime_min="0.5"
		lifetime_max="1.5"
		count_min="4"
		count_max="4"
		render_on_grid="1"
		fade_based_on_lifetime="1"
		area_circle_radius.min="28"
		area_circle_radius.max="28"
		cosmetic_force_create="0"
		airflow_force="0.3"
		airflow_time="0.01"
		airflow_scale="0.05"
		emission_interval_min_frames="1"
		emission_interval_max_frames="1"
		emit_cosmetic_particles="1"
		is_emitting="1" >
	</ParticleEmitterComponent>

	<Base file="data/entities/projectiles/deck/base_field.xml">
		<SpriteParticleEmitterComponent
			_enabled="0"
			>
		</SpriteParticleEmitterComponent>

		<ProjectileComponent
			damage_game_effect_entities=""
			>
		</ProjectileComponent>
	</Base>
</Entity>
